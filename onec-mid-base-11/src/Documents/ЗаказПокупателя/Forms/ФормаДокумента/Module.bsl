
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// + Ромина Ю.А. 2026-10-09 
    ДобавляемыеРеквизиты = Новый Массив;
    ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДЗ_КонтактноеЛицо", Новый ОписаниеТипов("СправочникСсылка.ДЗ_КонтактныеЛица"), , "Контактное лицо")); 	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ДЗ_СогласованнаяСкидка", Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(5, 2)), , "Согласованная скидка"));	
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);

    ЭлементДЗ_КонтактноеЛицо = Элементы.Добавить("ДЗ_КонтактноеЛицо", Тип("ПолеФормы"), Элементы.ГруппаШапкаПраво);
	ЭлементДЗ_КонтактноеЛицо.Вид = ВидПоляФормы.ПолеВвода;  
	ЭлементДЗ_КонтактноеЛицо.ПутьКДанным = "Объект.ДЗ_КонтактноеЛицо";
	ЭлементДЗ_КонтактноеЛицо.Заголовок = "Контактное лицо";
	
	ЭлементДЗ_ГруппаСкидка = Элементы.Добавить("ДЗ_ГруппаСкидка", Тип("ГруппаФормы"), Элементы.ГруппаШапкаЛево); 
	ЭлементДЗ_ГруппаСкидка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементДЗ_ГруппаСкидка.Отображение = ОтображениеОбычнойГруппы.Нет;  
	ЭлементДЗ_ГруппаСкидка.ОтображатьЗаголовок = Ложь; 
	ЭлементДЗ_ГруппаСкидка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	
	ЭлементДЗ_СогласованнаяСкидка = Элементы.Добавить("ДЗ_СогласованнаяСкидка", Тип("ПолеФормы"), Элементы.ДЗ_ГруппаСкидка);
	ЭлементДЗ_СогласованнаяСкидка.Вид = ВидПоляФормы.ПолеВвода;  
	ЭлементДЗ_СогласованнаяСкидка.ПутьКДанным = "Объект.ДЗ_СогласованнаяСкидка";
	ЭлементДЗ_СогласованнаяСкидка.Заголовок = "Согласованная скидка";
	ЭлементДЗ_СогласованнаяСкидка.УстановитьДействие("ПриИзменении", "ДЗ_СогласованнаяСкидкаПриИзменении");
		
	ДЗ_Команда = Команды.Добавить("ПересчитатьТаблицу");
	ДЗ_Команда.Заголовок = "Пересчитать таблицу"; 
	ДЗ_Команда.Действие = "ДЗ_ПересчитатьТаблицу"; 
	
	ДЗ_КнопкаФормы = Элементы.Добавить("КнопкаПересчитатьТаблицу", Тип("КнопкаФормы"), Элементы.ДЗ_ГруппаСкидка);
	ДЗ_КнопкаФормы.ИмяКоманды = "ПересчитатьТаблицу";
	ДЗ_КнопкаФормы.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	ДЗ_КнопкаФормы.Картинка = БиблиотекаКартинок.Обновить; 
	ДЗ_КнопкаФормы.Отображение = ОтображениеКнопки.КартинкаИТекст;
	Элементы.Товары.ПодчиненныеЭлементы.ТоварыСкидка.УстановитьДействие("ПриИзменении", "ДЗ_ТоварыСкидкаПриИзменении");
	Элементы.Услуги.ПодчиненныеЭлементы.УслугиСкидка.УстановитьДействие("ПриИзменении", "ДЗ_УслугиСкидкаПриИзменении");
	// - Ромина Ю.А. 2026-10-09 
КонецПроцедуры

