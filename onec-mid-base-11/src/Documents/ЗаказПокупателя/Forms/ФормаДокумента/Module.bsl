#Область ДЗ_Доработки

&НаКлиенте
Процедура ДЗ_ПересчитатьТаблицу(Команда)
	
	ДЗ_Пересчитать(Объект.Товары);
	ДЗ_Пересчитать(Объект.Услуги);
	
КонецПроцедуры 

&НаКлиенте
Процедура ДЗ_Пересчитать(Таблица) 
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		РассчитатьСуммуСтроки(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_СогласованнаяСкидкаПриИзменении(Элемент)
	
		ЕстьТоварыВДокументе = (Объект.Товары.Количество() > 0);
		ЕстьУслугиВДокументе = (Объект.Услуги.Количество() > 0);
       	ДопПараметры = Новый Структура();
		ДопПараметры.Вставить("ЕстьТоварыВДокументе", ЕстьТоварыВДокументе);
		ДопПараметры.Вставить("ЕстьУслугиВДокументе", ЕстьУслугиВДокументе);

		ТекстВопроса = "";
		Если ЕстьТоварыВДокументе Или ЕстьУслугиВДокументе Тогда
			ТекстВопроса = НСтр("ru = 'Табличная часть документа будет пересчитана. Пересчитать?'");
		КонецЕсли;
       	
		Если ЗначениеЗаполнено(ТекстВопроса) Тогда
			Оповещение = Новый ОписаниеОповещения("ЗапроситьПересчетТабличнойЧасти", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьПересчетТабличнойЧасти(Результат, ДопПараметры) Экспорт  
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ДопПараметры.ЕстьТоварыВДокументе Тогда
			ДЗ_Пересчитать(Объект.Товары)
		КонецЕсли;	 
		Если ДопПараметры.ЕстьУслугиВДокументе Тогда
			ДЗ_Пересчитать(Объект.Услуги)
		КонецЕсли;
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_ТоварыСкидкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	ТекущиеДанные.Сумма = (ТекущиеДанные.Цена * ТекущиеДанные.Количество)*(1 - ТекущиеДанные.Скидка/100);
		
КонецПроцедуры

&НаКлиенте
Процедура ДЗ_УслугиСкидкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Услуги.ТекущиеДанные;
	ТекущиеДанные.Сумма = (ТекущиеДанные.Цена * ТекущиеДанные.Количество)*(1 - ТекущиеДанные.Скидка/100);
		
КонецПроцедуры
